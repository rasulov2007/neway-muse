{
  "name": "@neway/api",
  "version": "0.1.0",
  "private": true,
  "description": "NEWAY TMS HTTP API (NestJS + Fastify)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@neway/shared": "0.1.0",
    "basic-ftp": "^5.0.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "nestjs-pino": "5.1.0",
    "nodemailer": "6.10.1",
    "pdf-lib": "1.17.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "resend": "6.32.1",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.3",
    "@types/nodemailer": "6.4.17",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "unplugin-swc": "1.5.11",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
