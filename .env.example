# NEWAY TMS - environment variables (copy to .env; never commit .env)

# development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=3000

# PostgreSQL connection string (local portable install or infra/docker-compose.yml; see README > Database)
DATABASE_URL=postgres://neway:neway@localhost:5432/neway

# Database used by integration/API tests (must be separate from DATABASE_URL)
TEST_DATABASE_URL=postgres://neway:neway@localhost:5432/neway_test

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Application secret used for signing. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# File storage driver: local | s3
STORAGE_DRIVER=local

# Directory used when STORAGE_DRIVER=local (git-ignored)
STORAGE_LOCAL_PATH=./storage

# Fill an empty database with the demo fleet, workforce and hiring funnel at boot: true | false.
# Unset = on outside production, off in production. A production workspace that was emptied with
# apps/api/dist/scripts/reset-workspace.js must keep this off or it refills itself on restart.
# SEED_DEMO_DATA=false

# The Fleet upgrade's endpoints (Today board, unit picker, work orders): true | false.
# Unset = on outside production, off in production. The browser has a matching build-time flag:
# VITE_FLAGS=fleet_v2 for the web build. Both must be on for the new Fleet screens to work.
# FLEET_V2=false

# How often every connected integration account (Samsara) is synced into the roster, unattended.
# 0 turns the clock off; "Sync now" on the Integrations screen still works. Read-only either way.
# INTEGRATION_SYNC_INTERVAL_MINUTES=60

# Web build only: which dataset the browser starts from. demo (default) generates the Northwind
# Freight workspace; empty starts every list at zero. A production build should use empty.
# VITE_DATASET=empty

# NeWay AI and the document readers on Meta Muse (Meta Model API, https://api.meta.ai/v1).
# Unset = NeWay AI says it is not set up. Never commit a real key.
# META_API_KEY=
# Read rate confirmations with Muse vision instead of the fallback reader: muse
# RC_READER_PROVIDER=muse

# Rate confirmation reader (Add load > upload RC). Sends the RC to Claude; unset = the reader
# says it is not set up. Key from console.anthropic.com.
# ANTHROPIC_API_KEY=
# RC_READER_MODEL=claude-opus-5

# Route options after Create load (TollGuru: tolls + fuel for up to 3 roads). Server only; unset =
# the panel says "TollGuru is not set up". The key needs an active TollGuru API plan.
# TOLLGURU_API_KEY=
# TOLLGURU_API_BASE=https://apis.tollguru.com

# Driver Relations -> Telegram management group (disabled until the owner configures it).
# Nothing is sent unless DR_TELEGRAM_ENABLED=true and both values below are set. Never commit a
# real token; set it in the server's environment only.
# DR_TELEGRAM_ENABLED=false
# TELEGRAM_DR_BOT_TOKEN=
# TELEGRAM_DR_CHAT_ID=
# DR_TMS_BASE_URL=https://neway.example.com

# Links sent to drivers (the DOT application, /dot/<token>) are built on this address.
# PUBLIC_APP_BASE_URL=https://neway.example.com
# Public link pages (/dot/<token>) answer only HTTPS requests (X-Forwarded-Proto via the trusted proxy).
# Unset: on in production, off in development and tests.
# PUBLIC_LINKS_REQUIRE_HTTPS=true

# NeWay mobile app push (Expo). Default https://exp.host/--/api/v2/push/send; tests point it at a stub.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Optional Expo access token (enhanced push security). Secret: server .env only.
# EXPO_ACCESS_TOKEN=
